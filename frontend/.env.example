# Anything starting with VITE_ is bundled into public JavaScript. Never put secrets here.
# Leave the API base empty in development (Vite proxies /api to localhost:4000).
VITE_API_BASE_URL=

# Supabase project URL and publishable/anon key are public browser credentials.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
