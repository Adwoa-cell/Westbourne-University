# Copy this file to .env and adjust. Placeholders only - never commit real secrets.
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173
# Set to 1 when running behind a proxy/load balancer (e.g. AWS App Runner) so rate limiting sees real client IPs.
TRUST_PROXY=0
# Where contact-form messages are stored locally until the database exists (Phase 2).
CONTACT_STORE_PATH=storage/contact-messages.jsonl
